# 複製成 .env.local 後修改
VITE_NETWORK_ID=testnet
VITE_CONTRACT_ID=seed-nft.your-account.testnet
VITE_RPC_URL=https://rpc.testnet.near.org
# 留空則用本站 /viewer/index.html；上傳 IPFS 後改成 https://<gateway>/ipfs/<CID>/index.html
VITE_VIEWER_URL=
# 多附的 storage 押金上限（NEAR），沒用完會退
VITE_STORAGE_BUFFER_NEAR=0.02
# 選填：Reown（原 WalletConnect）project id，到 https://cloud.reown.com 申請。
# 不填時 Ethereum 錢包只支援瀏覽器擴充（MetaMask 等）；填了才有 WalletConnect / 手機錢包。
VITE_REOWN_PROJECT_ID=
